PORT=3001

# Credenciales de PRUEBA (sandbox) de Mercado Pago.
# Sacalas de: https://www.mercadopago.com.ar/developers/panel → Tus integraciones → tu app → Credenciales de prueba
# Nunca pongas acá credenciales de PRODUCCIÓN.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cuenta de Gmail que envía los códigos de acceso (login por token).
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de 16 caracteres,
# NO tu contraseña normal de Gmail. Se genera en:
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
GMAIL_USER=ikicillof@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Solo para correr el backend en local SIN `netlify dev`: un Postgres propio.
# En Netlify no hace falta, la base se conecta sola (Netlify Database).
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/tienda_comics
